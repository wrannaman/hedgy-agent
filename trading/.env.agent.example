# Copy to trading/.env.agent (ignored). Authenticate the selected CLI separately.
AGENT_PROVIDER=claude
# Optional common override. Empty means the provider-specific default below.
AGENT_MODEL=
# Claude defaults to Opus 5.5; Codex uses its authenticated CLI model unless set.
CLAUDE_MODEL=claude-opus-5-5
# CODEX_MODEL=your-model-id
# CLAUDE_BIN=/absolute/path/to/claude
# CODEX_BIN=/absolute/path/to/codex
AGENT_TIMEOUT=1200
AGENT_MAX_ATTEMPTS=2
